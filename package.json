{
  "name": "tap-o",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "mobile": "npm run start -w @tap-o/mobile --",
    "web": "npm run web -w @tap-o/mobile",
    "server": "npm run dev -w @tap-o/server",
    "db:migrate": "npm run db:migrate -w @tap-o/server",
    "db:seed": "npm run db:seed -w @tap-o/server",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "typecheck": "tsc --noEmit -p packages/core && tsc --noEmit -p apps/server && tsc --noEmit -p apps/mobile",
    "lint": "npm run lint -w @tap-o/mobile",
    "build:server": "npm run build -w @tap-o/server",
    "build:web": "npm run export:web -w @tap-o/mobile",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "node scripts/serve-web.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "vitest": "^4.0.0"
  }
}
